# ── v3 AWS-Native Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in the values from `terraform output`
# or from the localstack-init.sh script for local development.

# ── AWS Credentials ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# For local development with LocalStack, override the endpoint:
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── Database (RDS Aurora PostgreSQL) ─────────────────────────────────────────
# Production: use the writer endpoint from `terraform output db_endpoint`
DB_HOST=
DB_PORT=5432
DB_USER=ticketing_admin
DB_PASSWORD=
DB_NAME=ticketing_system
DB_SSL_MODE=require
# Local: DB_HOST=localhost, DB_SSL_MODE=disable

# ── Cache (ElastiCache Redis) ─────────────────────────────────────────────────
# Production: use the endpoint from `terraform output redis_endpoint`
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true
# Local: REDIS_ADDR=localhost:6379

# ── SNS Topic ARNs ────────────────────────────────────────────────────────────
SNS_ARN_ORDER_CREATED=
SNS_ARN_ORDER_PAYMENT_CONFIRMED=
SNS_ARN_ORDER_CONFIRMED=
SNS_ARN_ORDER_CANCELLED=
SNS_ARN_ORDER_COMPLETED=
SNS_ARN_RESERVATION_EXPIRED=
SNS_ARN_INVENTORY_RELEASED=
SNS_ARN_EVENT_CANCELLED=
SNS_ARN_PAYMENT_COMPLETED=
SNS_ARN_TICKETS_GENERATED=
SNS_ARN_NOTIFICATION_EMAIL=
SNS_ARN_REFUND_APPROVED=
SNS_ARN_REFUND_COMPLETED=

# ── SQS Queue URLs ────────────────────────────────────────────────────────────
SQS_URL_PAYMENT_WORKER=
SQS_URL_TICKET_WORKER=
SQS_URL_TICKET_EMAIL_WORKER=
SQS_URL_EMAIL_WORKER=
SQS_URL_NOTIFICATION_WORKER=
SQS_URL_EVENT_CANCELLATION_WORKER=
SQS_URL_REFUND_PROCESSOR_WORKER=
SQS_URL_WAITLIST_WORKER=

# Analytics worker queues (one per topic)
SQS_URL_ANALYTICS_ORDER_CREATED=
SQS_URL_ANALYTICS_ORDER_CONFIRMED=
SQS_URL_ANALYTICS_PAYMENT_COMPLETED=
SQS_URL_ANALYTICS_ORDER_CANCELLED=
SQS_URL_ANALYTICS_EVENT_CANCELLED=
SQS_URL_ANALYTICS_TICKETS_GENERATED=

# ── S3 (unchanged from v2) ────────────────────────────────────────────────────
S3_ENABLED=true
S3_BUCKET=
S3_PUBLIC_URL=

# ── Application ───────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_ENV=production
APP_NAME=Ticketing System
APP_BASE_URL=
FRONTEND_URL=

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                  # must be exactly 16, 24, or 32 bytes

# ── Email ─────────────────────────────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Ticketing System
EMAIL_TEST_MODE=false

# ── Payment Gateways ──────────────────────────────────────────────────────────
INTASEND_SECRET_KEY=
INTASEND_TEST_MODE=false
